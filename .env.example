# Telegram
TELEGRAM_BOT_TOKEN=          # stored by the Telegram channel plugin in ~/.jarvis/claude/channels/telegram/.env
JARVIS_CHAT_ID=              # required: the one Telegram chat Jarvis talks to
# Google (Gmail, Calendar, Tasks via OAuth; client_secret.json goes in ~/.jarvis/)
JARVIS_USER_EMAIL=           # required: the Google account Jarvis acts for
JARVIS_TASKLIST_ID=          # optional, defaults to @default
JARVIS_MAIL_LABELS=          # optional, comma separated labels summarised in the morning brief
JARVIS_WATCH_QUERY=          # optional Gmail query for mail worth an immediate look
JARVIS_USER_NAME=            # optional, used in the morning greeting
# Runtime
JARVIS_HOME=                 # optional, defaults to ~/.jarvis (secrets and state live here, outside the repo)
JARVIS_PORT=                 # optional, defaults to 8765 (bound to 127.0.0.1)
JARVIS_WHISPER=              # optional speech model name
JARVIS_WHISPER_PROMPT=       # optional speech-to-text hint sentence
